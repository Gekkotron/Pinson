# Copy to .env (git-ignored) next to where you start Pinson. Any MUSIC_* setting from the
# README works here. Variables already set in the shell, and command-line flags, win over this file.

# Startup output. Unset: choose one in the web app. nidoo plays through nidoo-sound (the old default).
# Other values: snapcast, chromecast, upnp, stream, local (this computer's sound card) and log.
# MUSIC_ENGINE=nidoo

# Snapcast output: the snapserver tcp source Pinson writes to, and snapserver's JSON-RPC control port.
# MUSIC_SNAPCAST=127.0.0.1:4953
# MUSIC_SNAPCAST_CONTROL=127.0.0.1:1705
# MUSIC_SNAPCAST_LATENCY_MS=1200

# Chromecast output: the device to play on (name, Cast id or host:port), with MUSIC_ENGINE=chromecast.
# Unset: pick one in the web app. The device fetches music from Pinson, so allow inbound TCP on MUSIC_PORT.
# MUSIC_CHROMECAST=Kitchen speaker
# Where Cast and UPnP devices reach Pinson (http:// or https://). Default: the address facing the device.
# MUSIC_PUBLIC_URL=http://192.168.1.50:8082

# UPnP/DLNA (and Sonos) output: the renderer to play on (friendly name, UDN or description URL), with
# MUSIC_ENGINE=upnp. Unset: pick one in the web app. MUSIC_PUBLIC_URL above applies here too.
# MUSIC_UPNP=Living Room TV

# Stream URL output: how far behind /stream.mp3 listeners are assumed to be. Only moves the progress bar.
# MUSIC_STREAM_LATENCY_MS=1000

# MQTT: Pinson as a media player for a home hub (Nidoo). Leave the broker unset to turn MQTT off.
MUSIC_MQTT_BROKER=192.168.1.91:1883
# MUSIC_MQTT_USER=
# MUSIC_MQTT_PASSWORD=

# RUST_LOG=info

# Copy to .env (git-ignored) next to where you start Pinson. Any MUSIC_* setting from the
# README works here. Variables already set in the shell, and command-line flags, win over this file.

# Startup output. Unset: choose one in the web app. nidoo plays through nidoo-sound (the old default).
# MUSIC_ENGINE=nidoo

# MQTT: Pinson as a media player for a home hub (Nidoo). Leave the broker unset to turn MQTT off.
MUSIC_MQTT_BROKER=192.168.1.91:1883
# MUSIC_MQTT_USER=
# MUSIC_MQTT_PASSWORD=

# RUST_LOG=info
